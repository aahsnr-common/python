#!/usr/bin/env bash
# .envrc — fully automated uv-managed Python 3.14 environment
#
# Requires:
#   - direnv   https://direnv.net
#   - uv       https://docs.astral.sh/uv
#
# Layout this expects:
#   project-root/
#     .envrc                     (this file)
#     .python-version            (written automatically, holds "3.14")
#     requirements.txt           (your libraries + dev tools, flat list)
#     bin/update-python-env.sh   (companion maintenance script, see below)
#     src/                       (ALL .py files live directly in here —
#                                 no package subfolders under src/)
#     .venv/                     (created automatically, gitignore it)
#     .direnv/                   (direnv + this script's state, gitignore it)
#
# First-time setup:
#   1. Save this file as .envrc at the project root.
#   2. Save the companion script as bin/update-python-env.sh and
#      chmod +x bin/update-python-env.sh
#   3. Create requirements.txt (even an empty file is fine to start).
#   4. Run: direnv allow
#
# What happens automatically on every `cd` into the project:
#   - uv-managed Python 3.14 is installed if it isn't already present
#   - ./.venv is created against that interpreter if it doesn't exist
#   - requirements.txt is (re)installed into .venv, but ONLY when its
#     contents changed since the last time (hash-checked, so this is
#     instant on a normal `cd`)
#   - ./src is put on PYTHONPATH so flat modules import cleanly
#   - src/ is checked for .py files nested in a subfolder; if any are
#     found, loading is aborted with an explicit error (see below)
#   - roughly once a week (configurable) a background maintenance pass
#     is kicked off: it updates uv itself, upgrades Python 3.14 to its
#     latest patch, upgrades every package in requirements.txt, removes
#     packages no longer listed there, upgrades any `uv tool install`ed
#     CLI tools, uninstalls now-superseded Python patch builds, and
#     prunes uv's cache
#
# Manual maintenance whenever you want it (no need to wait for the
# weekly schedule):
#   ./bin/update-python-env.sh
#
# Tuning:
#   export UV_ENVRC_UPDATE_INTERVAL_DAYS=1     # check for updates daily
#   export UV_ENVRC_PURGE_OTHER_MINORS=1       # also remove unrelated
#                                               # Python minor versions
#                                               # uv manages on this
#                                               # machine (off by default
#                                               # so other projects that
#                                               # pin a different Python
#                                               # version are untouched)

set -uo pipefail

PROJECT_ROOT="$(pwd)"
SRC_DIR="$PROJECT_ROOT/src"
VENV_DIR="$PROJECT_ROOT/.venv"
REQ_FILE="$PROJECT_ROOT/requirements.txt"
PY_VERSION_FILE="$PROJECT_ROOT/.python-version"
STATE_DIR="$PROJECT_ROOT/.direnv/uv-python-env"
UPDATE_SCRIPT="$PROJECT_ROOT/bin/update-python-env.sh"

PY_VERSION="3.14"
if [ -f "$PY_VERSION_FILE" ]; then
  PY_VERSION="$(tr -d '[:space:]' <"$PY_VERSION_FILE")"
fi

mkdir -p "$STATE_DIR"

# ---------------------------------------------------------------------
# 0. Sanity checks
# ---------------------------------------------------------------------
if ! has uv; then
  log_error "uv is not installed or not on PATH."
  log_error "Install it: https://docs.astral.sh/uv/getting-started/installation/"
  return 1
fi

# ---------------------------------------------------------------------
# 1. Enforce the flat src/ layout: no .py file may live in a subfolder
#    of src/. This is checked on every load.
# ---------------------------------------------------------------------
if [ -d "$SRC_DIR" ]; then
  nested_py="$(find "$SRC_DIR" -mindepth 2 -type f -name '*.py' \
    -not -path '*/__pycache__/*' 2>/dev/null || true)"
  if [ -n "$nested_py" ]; then
    log_error "Flat src/ layout violated — .py files found nested inside a subfolder of src/:"
    while IFS= read -r f; do
      log_error "  $f"
    done <<<"$nested_py"
    log_error "Move these files directly into src/ (or delete the subfolder), then run: direnv reload"
    return 1
  fi
else
  mkdir -p "$SRC_DIR"
  log_status "created empty src/ directory"
fi

# ---------------------------------------------------------------------
# 2. Install the pinned Python version and create the venv
# ---------------------------------------------------------------------
if ! uv python list --only-installed 2>/dev/null | grep -q "cpython-${PY_VERSION}\."; then
  log_status "installing Python ${PY_VERSION} via uv"
  uv python install "$PY_VERSION" || {
    log_error "failed to install Python ${PY_VERSION}"
    return 1
  }
fi

if [ ! -f "$PY_VERSION_FILE" ]; then
  uv python pin "$PY_VERSION" >/dev/null 2>&1 || true
fi

if [ ! -x "$VENV_DIR/bin/python" ]; then
  log_status "creating .venv (Python ${PY_VERSION})"
  uv venv --python "$PY_VERSION" "$VENV_DIR" || {
    log_error "failed to create .venv"
    return 1
  }
fi

# ---------------------------------------------------------------------
# 3. Install / refresh requirements.txt, only when it actually changed
# ---------------------------------------------------------------------
hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    openssl dgst -sha256 "$1" | awk '{print $NF}'
  fi
}

if [ -f "$REQ_FILE" ]; then
  watch_file "$REQ_FILE"
  req_hash_file="$STATE_DIR/requirements.sha256"
  current_hash="$(hash_file "$REQ_FILE")"
  stored_hash="$(cat "$req_hash_file" 2>/dev/null || true)"
  if [ "$current_hash" != "$stored_hash" ]; then
    log_status "installing dependencies from requirements.txt"
    uv pip install -r "$REQ_FILE" --python "$VENV_DIR/bin/python" ||
      {
        log_error "uv pip install -r requirements.txt failed"
        return 1
      }
    echo "$current_hash" >"$req_hash_file"
  fi
else
  log_status "no requirements.txt yet at project root — create one when ready"
fi

# ---------------------------------------------------------------------
# 4. Activate the venv, expose the flat src/ layout
# ---------------------------------------------------------------------
export VIRTUAL_ENV="$VENV_DIR"
PATH_add "$VENV_DIR/bin"
export PYTHONPATH="$SRC_DIR${PYTHONPATH:+:$PYTHONPATH}"
export UV_PYTHON_PREFERENCE="only-managed"

watch_file "$PY_VERSION_FILE"
[ -f "$UPDATE_SCRIPT" ] && watch_file "$UPDATE_SCRIPT"

# ---------------------------------------------------------------------
# 5. Scheduled background maintenance (update + cleanup automation)
# ---------------------------------------------------------------------
interval_days="${UV_ENVRC_UPDATE_INTERVAL_DAYS:-7}"
last_run_file="$STATE_DIR/last-maintenance"
maint_log="$STATE_DIR/maintenance.log"
now_epoch="$(date +%s)"
last_epoch="$(cat "$last_run_file" 2>/dev/null || echo 0)"
age_days=$(((now_epoch - last_epoch) / 86400))

if [ -x "$UPDATE_SCRIPT" ] && [ "$age_days" -ge "$interval_days" ]; then
  log_status "scheduled maintenance is due — running it in the background (log: .direnv/uv-python-env/maintenance.log)"
  echo "$now_epoch" >"$last_run_file"
  (nohup "$UPDATE_SCRIPT" >>"$maint_log" 2>&1 &)
elif [ ! -x "$UPDATE_SCRIPT" ]; then
  log_status "bin/update-python-env.sh not found or not executable — automated updates disabled until it's added"
fi
