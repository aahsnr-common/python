# vim: ft=sh
# ============================================================================
# .envrc for Python 3.13 projects using `uv` and `direnv`
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Configurable Common Libraries
# ----------------------------------------------------------------------------
# Customize these arrays to automatically install your preferred stack
# whenever a new project is bootstrapped. Leave empty [] to skip.
COMMON_LIBS=(
  "requests"
  "python-dotenv"
  "pydantic"
  "rich"
)

COMMON_DEV_LIBS=(
  "ruff"
  "pytest"
  "pytest-cov"
  "mypy"
  "ipython"
  "ipdb"
  "numpy"
  "pandas"
  "ipykernel"
  "jupyterlab"
  "passagemath-standard"
)

# ----------------------------------------------------------------------------
# 2. Strict Mode & Prerequisite Checks
# ----------------------------------------------------------------------------
set -uo pipefail

if ! has uv; then
  log_error "uv is not installed or not in PATH."
  log_error "Install it with: curl -LsSf https://astral.sh/uv/install.sh | sh"
  exit 1
fi

# ----------------------------------------------------------------------------
# 3. Project Scaffolding & Safety Checks
# ----------------------------------------------------------------------------
# FIX: Rename reserved "python" project name to prevent venv script shadowing.
if [[ -f pyproject.toml ]]; then
  if grep -q '^name = "python"$' pyproject.toml; then
    log_status "Fixing reserved project name in pyproject.toml..."
    sed -i.bak 's/^name = "python"$/name = "python-project"/' pyproject.toml
    rm -f pyproject.toml.bak
  fi
fi

if [[ ! -f pyproject.toml ]]; then
  dir_name="$(basename "$PWD")"
  project_name=$(echo "$dir_name" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')

  # Prevent reserved names that break venv scripts
  if [[ "$project_name" =~ ^(python|pip|pydoc|site-packages)$ ]]; then
    project_name="${project_name}-project"
  fi

  log_status "Initializing new uv Python project ($project_name)..."
  uv init --python 3.13 --name "$project_name" >/dev/null 2>&1 || {
    log_error "uv init failed."
    exit 1
  }

  # Add common runtime libraries
  if [[ ${#COMMON_LIBS[@]} -gt 0 ]]; then
    log_status "Adding common libraries..."
    if ! uv add "${COMMON_LIBS[@]}" >/dev/null 2>&1; then
      log_status "Warning: Some common libraries failed to install. Check package names or network."
    fi
  fi

  # Add common development tools
  if [[ ${#COMMON_DEV_LIBS[@]} -gt 0 ]]; then
    log_status "Adding common dev tools..."
    if ! uv add --dev "${COMMON_DEV_LIBS[@]}" >/dev/null 2>&1; then
      log_status "Warning: Some common dev tools failed to install."
    fi
  fi
fi

# Ensure .python-version exists and pins 3.13
if [[ ! -f .python-version ]]; then
  echo "3.13" >.python-version
fi

# ----------------------------------------------------------------------------
# 4. Python Interpreter Installation
# ----------------------------------------------------------------------------
if ! uv python list --only-installed 2>/dev/null | grep -q "3.13"; then
  log_status "Installing Python 3.13 via uv..."
  uv python install 3.13 >/dev/null 2>&1 || {
    log_error "Failed to install Python 3.13."
    exit 1
  }
fi

# ----------------------------------------------------------------------------
# 5. Virtual Environment Setup
# ----------------------------------------------------------------------------
venv_dir="${UV_PROJECT_ENVIRONMENT:-.venv}"

unset PYTHONHOME
export VIRTUAL_ENV="$PWD/$venv_dir"

if [[ ! -d "$venv_dir" ]]; then
  log_status "Creating virtual environment..."
  uv venv --python 3.13 "$venv_dir" >/dev/null 2>&1 || {
    log_error "uv venv failed."
    exit 1
  }
fi

if [[ "${OSTYPE:-}" == "msys" || "${OSTYPE:-}" == "cygwin" || "${OSTYPE:-}" == "win32" ]]; then
  PATH_add "$venv_dir/Scripts"
else
  PATH_add "$venv_dir/bin"
fi

# ----------------------------------------------------------------------------
# 6. Dependency Syncing & Update Checking
# ----------------------------------------------------------------------------
watch_file pyproject.toml
if [[ -f uv.lock ]]; then
  watch_file uv.lock
fi

mkdir -p .direnv
sync_marker="$PWD/.direnv/sync_marker"
update_marker="$PWD/.direnv/update_marker"

needs_sync=0
if [[ ! -f "$sync_marker" ]]; then
  needs_sync=1
elif [[ "pyproject.toml" -nt "$sync_marker" ]]; then
  needs_sync=1
elif [[ -f "uv.lock" && "uv.lock" -nt "$sync_marker" ]]; then
  needs_sync=1
fi

if [[ "$needs_sync" -eq 1 ]]; then
  log_status "Syncing dependencies and tools..."
  sync_out=$(mktemp)
  if ! uv sync >"$sync_out" 2>&1; then
    log_error "uv sync failed:"
    cat "$sync_out" | while read -r line; do log_error "  $line"; done
    rm -f "$sync_out"
    exit 1
  fi
  rm -f "$sync_out"
  touch "$sync_marker"
fi

needs_update_check=0
if [[ ! -f "$update_marker" ]]; then
  needs_update_check=1
else
  if [[ "$(find "$update_marker" -mmin +1440 2>/dev/null)" ]]; then
    needs_update_check=1
  fi
fi

if [[ "$needs_update_check" -eq 1 ]]; then
  outdated=$(uv pip list --outdated --color=never 2>/dev/null | grep -v "Package" || true)
  if [[ -n "$outdated" ]]; then
    log_status "Outdated packages found (run 'uv lock --upgrade' to update):"
    log_status "$outdated"
  fi
  touch "$update_marker"
fi

# ----------------------------------------------------------------------------
# 7. Standard Python Environment Variables
# ----------------------------------------------------------------------------
export PYTHONDONTWRITEBYTECODE=1
export PYTHONUNBUFFERED=1

if [[ ! -d "src" ]]; then
  export PYTHONPATH="$PWD:${PYTHONPATH:-}"
fi

# ----------------------------------------------------------------------------
# 8. Local Configuration & Gitignore Management
# ----------------------------------------------------------------------------
dotenv_if_exists .env

if [[ ! -f .gitignore ]]; then
  touch .gitignore
fi
for pattern in ".venv/" ".direnv/" ".env" "__pycache__/" "*.pyc"; do
  if ! grep -qFx "$pattern" .gitignore 2>/dev/null; then
    echo "$pattern" >>.gitignore
  fi
done
